<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: adaptive icon (the launcher masks and animates the layers). Android 13+ also uses
     the monochrome layer for themed icons. Android 7 uses the PNGs in mipmap-*dpi. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/q_orange" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
