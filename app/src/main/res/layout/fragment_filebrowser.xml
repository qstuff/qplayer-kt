<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black" >

    <TextView
        android:id="@+id/fileBrowserHeader"
        style="@style/PlayerTextStyle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="5dp" />

    <ImageView
        android:id="@+id/fileBrowserGoToParentDir"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/textview_height"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:gravity="left"
        android:layout_gravity="left"
        android:src="@drawable/ic_subdirectory_arrow_left_white_24dp"
        android:rotation="90"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fileBrowserRecycler"
        style="@style/ListView.FileList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp" />

</LinearLayout>

