<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:layout_gravity="center"
    android:background="@drawable/selector_tracklist_item"
    card_view:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/textview_height"
        android:orientation="horizontal"
        android:background="@color/black">

        <ImageView
            android:id="@+id/playlistItemIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:layout_gravity="center"
            card_view:srcCompat="@drawable/ic_playlist"/>

        <TextView
            android:id="@+id/playlistItemText"
            style="@style/PlayerTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center"
            android:background="@drawable/selector_tracklist_item"
            tools:text="this is a playlist"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>



