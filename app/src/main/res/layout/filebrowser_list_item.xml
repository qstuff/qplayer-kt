<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:layout_gravity="center"
    android:background="@drawable/selector_tracklist_item"
    card_view:cardPreventCornerOverlap="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/textview_height"
        android:background="@color/black">

        <ImageView
            android:id="@+id/fileListItemIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:scaleType="fitCenter"
            android:layout_gravity="center"
            card_view:srcCompat="@drawable/icon_track" />

        <TextView
            android:id="@+id/fileListItemTitle"
            style="@style/PlayerTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/fileListItemIcon"
            android:layout_toStartOf="@+id/fileListItemPrelistenButton"
            android:gravity="start|center"
            android:background="@drawable/selector_tracklist_item"
            tools:text="holla di bolla"/>

        <ImageView
            android:id="@+id/fileListItemPrelistenButton"
            style="@style/PlayerButtonStyle"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:src="@drawable/selector_tracklist_prelisten"/>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
