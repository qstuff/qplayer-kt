    <string name="settings_cat_dj_specific_options_title">Einstellungen für DJ Features</string>

    <string name="settings_dj_enable_cue">Cue-Punkt setzen</string>
    <string name="settings_dj_enable_cue_summary">Aktivieren um einen Cue-Punkt setzen zu können (Tap auf CUE aktiviert, Long-Tap löscht den Cue-Punkt).</string>

    <string name="settings_dj_stop_playback_on_cue_title">Wiedergabe stoppen beim Cue-Punkt setzen</string>
    <string name="settings_dj_stop_playback_on_cue_summary">Wenn aktiviert stoppt die Wiedergabe beim Setzen eines Cue-Punktes</string>

    <string name="settings_dj_enable_remain_blink_title">Zeitanzeige für \"remain\" blinkt</string>
    <string name="settings_dj_remain_blink_summary">Wenn aktiviert blinkt die Zeitanzeige während der letzten 30 Sekunden eines Tracks</string>

