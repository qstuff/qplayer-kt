    <!-- Basic Playback Settings -->
    <string name="settings_cat_player_basic_title">Einstellungen für Wiedergabe</string>

    <string name="settings_track_autostart_title">Track autoplay</string>
    <string name="settings_track_autostart_summary">Wenn aktiviert wird ein Track nach Auswahl in der Queue oder nach Skip sofort abgespielt.</string>

    <string name="settings_proceed_to_next_track_title">Automatisch zum nächsten Track</string>
    <string name="settings_proceed_to_next_track_summary">Wenn aktiviert wird nach Trackende automatisch der nächste Track geladen.</string>

    <string name="settings_skip_back_behaviour_title">Skip-Back Verhalten</string>
    <string name="settings_skip_back_behaviour_summary">Wenn aktiviert führt Skip-Back zum Anfang des Tracks und stoppt dort auf jeden Fall.\nWenn deaktiviert wird zum vorherigen Track gesprungen.\nBeachte, dass diese Einstellung auch im Shuffle Mode aktiv ist.</string>

    <string name="settings_show_clear_queue_title">Warndialog für Clear-Queue zeigen</string>
    <string name="settings_show_clear_queue_summary">Wenn aktiviert wird vor dem Löschen der Queue ein Warndialog angezeigt</string>

