<?xml version="1.0" encoding="utf-8"?>
<!--
  Single source of dimensions. dp/sp already scale with density, so there are no
  per-density (hdpi/xhdpi/…) variants. Values reflect the previous xxhdpi bucket
  (the common phone density). Tablet overrides live in values-sw600dp / values-sw720dp.
-->
<resources>

    <!-- Player screen -->
    <dimen name="jog_wheel_border">4dp</dimen>
    <dimen name="jog_wheel_margin_right">4dp</dimen>

    <dimen name="pitchbar_width">62dp</dimen>
    <dimen name="seekbar_height">62dp</dimen>

    <dimen name="textview_height">32dp</dimen>
    <dimen name="title_textview_height">32dp</dimen>
    <dimen name="textview_padding_start">12dp</dimen>
    <dimen name="textview_padding_end">12dp</dimen>

    <dimen name="font_size_player_text">16sp</dimen>

    <dimen name="rounded_shape_radius">7dp</dimen>

    <dimen name="clearbutton_size">30dp</dimen>
    <dimen name="kebabbutton_size">25dp</dimen>

    <!-- Waveform / cue overlay -->
    <dimen name="waveform_side_margin">10dp</dimen>
    <dimen name="waveform_top_margin">2dp</dimen>
    <dimen name="cue_marker_width">30dp</dimen>
    <dimen name="cue_marker_top_margin">15dp</dimen>

</resources>
